* text=auto

# Arquivos lidos dentro do container Linux: CRLF quebra linhas RUN e diretivas.
Dockerfile text eol=lf
nginx.conf text eol=lf
captain-definition text eol=lf
*.sh text eol=lf

# Scripts do Windows: CRLF é o esperado.
*.ps1 text eol=crlf

# Originais e cópias servidas pela aplicação nunca passam por conversão.
*.png binary
*.jpeg binary
*.jpg binary
